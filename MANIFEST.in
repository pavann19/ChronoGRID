include pyproject.toml MANIFEST.in LICENSE README.md NOTICE
recursive-include chronogrid *.py
include chronogrid/operations/feature_contract_bindings.json
prune artifacts
prune data
prune docs
prune tests
prune scripts
prune frontend
prune deployment
prune .github
prune .tools
exclude .env
global-exclude *.pyc *.pyo *.sqlite *.db
