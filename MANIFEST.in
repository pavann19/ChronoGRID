include pyproject.toml MANIFEST.in LICENSE OPERATIONS.md
recursive-include src *.py
include src/operations/feature_contract_bindings.json
prune artifacts
prune data
prune docs
prune tests
prune scripts
prune frontend
prune deployment
prune .github
prune .tools
exclude README.md requirements.txt .env
global-exclude *.pyc *.pyo *.sqlite *.db
