# ==============================================================================
# ChronoGrid — Production .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches and runtime metadata
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.hypothesis/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Machine-specific logs
*.log
mlruns/.trash/
nohup.out

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Runtime transient ingestion outputs (canonical dataset is data/raw/genuine_smard_dwd_observations.parquet)
data/raw/smard_dwd_raw_*.parquet
data/dqcp_aci_state*.json

# Dynamic model promotion backups & staging scratch
artifacts/models/backup/
artifacts/models/staging/
*.tmp
# Operations runtime data and local tooling
.tools/
data/operations/
.playwright-cli/
# Browser outputs are versioned only when explicitly staged as checkpoint evidence.
output/playwright/*.zip
deployment/wheelhouse/

# Historical evidence is exported locally, not committed repeatedly.
mlruns/
output/
artifacts/engineering/
data/*.db
build/
*.egg-info/
pip-*/
pytest-of-*/
tmp*
artifacts/experiments/weather_v4/**
!artifacts/experiments/weather_v4/report.json
!artifacts/experiments/weather_v4/replay_evidence.zip

artifacts/reports/benchmark_corrected/per_hour_predictions.csv
