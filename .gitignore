# ==============================================================================
# ChronoGrid — Production .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches and runtime metadata
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.hypothesis/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Machine-specific logs
*.log
mlruns/.trash/
nohup.out

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Runtime transient ingestion outputs (canonical dataset is data/raw/genuine_smard_dwd_observations.parquet)
data/raw/smard_dwd_raw_*.parquet
data/dqcp_aci_state*.json

# Dynamic model promotion backups & staging scratch
artifacts/models/backup/
artifacts/models/staging/
*.tmp
# Operations runtime data and local tooling
.tools/
data/operations/
.playwright-cli/
# Browser outputs are versioned only when explicitly staged as checkpoint evidence.
output/playwright/*.zip
deployment/wheelhouse/

# Historical evidence is exported locally, not committed repeatedly.
mlruns/
output/
artifacts/engineering/
data/*.db
build/
*.egg-info/
pip-*/
pytest-of-*/
tmp*

artifacts/reports/benchmark_corrected/per_hour_predictions.csv

/artifacts/reports/cleanup_report.md

# Local historical working notes and superseded reports
/docs/archive/
/docs/HISTORY_REWRITE.md
/artifacts/reports/ddir_benchmark_results.json
/artifacts/reports/ddir_sprint_2_1_audit.json
/artifacts/reports/ddir_sprint_2_1_prediction_comparison.csv
/artifacts/reports/ddir_sprint_2_2_audit.json
/artifacts/reports/ddir_sprint_2_2_remediation_benchmark.json
/artifacts/reports/ddir_sprint_3_0_calibration_feasibility.json
/artifacts/reports/ddir_sprint_3_0_prediction_lineage.json
/artifacts/reports/ddir_sprint_3_1_effective_sample_analysis.json
/artifacts/reports/ddir_sprint_3_1_method_comparison.json
/artifacts/reports/ddir_sprint_3_1_model_calibration_compatibility.json
/artifacts/reports/ddir_sprint_3_2_1_audit.json
/artifacts/reports/ddir_sprint_3_2_2_remediation.json
/artifacts/reports/ddir_sprint_3_2_2_timeline_audit.json
/artifacts/reports/ddir_sprint_3_3_1_bootstrap_sensitivity.csv
/artifacts/reports/ddir_sprint_3_3_1_numerical_reconciliation.json
/artifacts/reports/ddir_sprint_3_3_1_paired_daily_errors.csv
/artifacts/reports/ddir_sprint_3_3_1_per_horizon.csv
/artifacts/reports/ddir_sprint_3_3_1_per_origin.csv
/artifacts/reports/ddir_sprint_3_3_1_reconstructed_per_hour.csv
/artifacts/reports/ddir_sprint_3_3_benchmark.json
/artifacts/reports/research_closure_validation.txt
/artifacts/reports/research_sprint1_1_reconciliation.json
/artifacts/reports/research_sprint1_weather_stats.json
/artifacts/reports/*cleanup*/
/docs/*_notes.md
