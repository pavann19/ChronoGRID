    },
    "delivery_timestamp": {
      "format": "date-time",
      "title": "Delivery Timestamp",
      "type": "string"
    },
    "observation_end": {
      "format": "date-time",
      "title": "Observation End",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Snapshot Sha256",
      "type": "string"
